FROM python:3.8-alpine AS prod_base
LABEL maintainer="farsheed.ashouri@gmail.com"

WORKDIR /app

COPY requirements.txt .

RUN \
 apk add --no-cache postgresql-libs && \
 apk add --no-cache --virtual .build-deps gcc musl-dev postgresql-dev g++ python3-dev libxml2 libxml2-dev libxslt-dev && \
 python3 -m pip install -r requirements.txt --no-cache-dir && \
 apk --purge del .build-deps

RUN apk add --no-cache libxml2 libxml2-dev libxslt-dev

FROM prod_base AS prod_bin

COPY --from=farshidashouri/bento4:latest /opt/bento4 /Bento4
COPY --from=farshidashouri/ffmpeg:latest /opt/ffmpeg /opt/ffmpeg
COPY --from=farshidashouri/ffmpeg:latest /usr/lib/. /usr/local/lib/
ENV PATH=/opt/ffmpeg/bin:/Bento4/bin:$PATH
ENV BENTO4_PATH=/Bento4
ENV REDIS_HOST=redis

COPY . .


FROM prod_bin AS prod_server
EXPOSE 4000
CMD ["gunicorn", "server", "-b", "0.0.0.0:4000", "-t", "300", "-w", "4", "--log-level", "info"]

FROM prod_bin AS prod_celery
CMD ["celery", "-A", "tasks", "worker", "--concurrency", "4", "-l", "info"]
